<file path="prisma/schema.prisma">
// prisma/schema.prisma
// ─────────────────────────────────────────────────────────────────────────────
// Real Estate Dashboard — Schema final
// Sistema 2 del ecosistema SaaS multi-tenant
//
// INSTRUCCIONES:
//   1. Reemplazar prisma/schema.prisma con este archivo
//   2. pnpm prisma migrate dev --name real_estate_domain
//   3. pnpm prisma generate
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENTE
  VIEWER
}

enum TipoPropiedad {
  CASA
  DEPARTAMENTO
  TERRENO
  LOCAL
  OFICINA
  GALPON
  CAMPO
}

enum TipoOperacion {
  VENTA
  ALQUILER
  ALQUILER_TEMP
}

enum EstadoPropiedad {
  DISPONIBLE
  RESERVADA
  VENDIDA
  ALQUILADA
  PAUSADA
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH — Usuario con Firebase SSO como identidad principal
// passwordHash y refreshToken quedan nullable para migración gradual
// desde el JWT legacy que tenía el proyecto original.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  nombre        String

  // Firebase SSO — identidad principal
  firebaseUid   String?  @unique @map("firebase_uid")
  firebaseEmail String?  @map("firebase_email")

  // JWT legacy — nullable, mantener hasta migración completa
  passwordHash  String?  @map("password_hash")
  refreshToken  String?  @map("refresh_token")

  role          Role     @default(AGENTE)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  auditLogs     AuditLog[]

  @@index([email])
  @@index([firebaseUid])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZACIONES — Tenant raíz del ecosistema
// enabledProducts y systemSettings son JSONB: nunca migrar para agregar sistema.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  // JSONB — ej: { "propiedades": true, "chat": true, "pagos": false }
  enabledProducts Json     @default("{}") @map("enabled_products")
  // JSONB — configuración global de la org por sistema
  systemSettings  Json     @default("{}") @map("system_settings")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  zonas           Zona[]
  propiedades     Propiedad[]
  auditLogs       AuditLog[]

  @@index([slug])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// ZONAS — Agrupación geográfica de propiedades (reemplaza PuntoDeVenta)
// ─────────────────────────────────────────────────────────────────────────────

model Zona {
  id             String       @id @default(uuid())
  nombre         String
  ciudad         String?
  provincia      String?
  descripcion    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  propiedades    Propiedad[]

  @@index([organizationId])
  @@map("zonas")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROPIEDADES — Entidad de dominio principal del real estate
// ─────────────────────────────────────────────────────────────────────────────

model Propiedad {
  id             String          @id @default(uuid())
  titulo         String
  descripcion    String?
  tipo           TipoPropiedad
  operacion      TipoOperacion
  precio         Decimal         @db.Decimal(14, 2)
  moneda         String          @default("USD")
  superficie     Decimal?        @db.Decimal(10, 2)
  ambientes      Int?
  banos          Int?
  dormitorios    Int?
  direccion      String?
  estado         EstadoPropiedad @default(DISPONIBLE)
  destacada      Boolean         @default(false)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id])

  zonaId         String?         @map("zona_id")
  zona           Zona?           @relation(fields: [zonaId], references: [id])

  imagenes       PropiedadImagen[]

  @@index([organizationId])
  @@index([zonaId])
  @@index([tipo])
  @@index([operacion])
  @@index([estado])
  @@index([precio])
  @@map("propiedades")
}

model PropiedadImagen {
  id          String    @id @default(uuid())
  url         String
  orden       Int       @default(0)
  alt         String?
  createdAt   DateTime  @default(now()) @map("created_at")

  propiedadId String    @map("propiedad_id")
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId])
  @@map("propiedad_imagenes")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — append-only, nunca se borra
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(uuid())
  action         String                           // ej: "propiedad.create"
  entityType     String        @map("entity_type") // ej: "Propiedad"
  entityId       String?       @map("entity_id")
  payload        Json          @default("{}")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")

  userId         String?       @map("user_id")
  user           User?         @relation(fields: [userId], references: [id])

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
</file>

